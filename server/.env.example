PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/itms
CLIENT_URL=http://localhost:3000
JWT_ACCESS_SECRET=change_this_to_a_long_random_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_refresh_secret_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false
UPLOAD_DIR=src/uploads
MAX_FILE_SIZE_MB=10
PASSWORD_RESET_EXPIRES_MINUTES=30
